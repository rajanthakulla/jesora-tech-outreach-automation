# JESORA TECH (jesoratech.com) - 24x7 Outreach Automation Configuration

# Server Port (Default: 3800)
PORT=3800

# SMTP Outbound Email Settings (Google Workspace / Gmail / AWS SES / Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=techjesora@gmail.com
SMTP_PASS=your_app_password_here

# IMAP Inbound Mail Polling (Optional - Can also use webhook / simulator)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=techjesora@gmail.com
IMAP_PASS=your_app_password_here

# AI Enhancement Provider (Optional: gemini | openai | groq | builtin)
AI_PROVIDER=builtin
AI_API_KEY=
GEMINI_API_KEY=

# Telegram Real-Time Push Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Lead Prospecting & Verification APIs
GEOAPIFY_API_KEY=your_geoapify_key_here
APOLLO_API_KEY=your_apollo_key_here
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# Neon / Cloud PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
